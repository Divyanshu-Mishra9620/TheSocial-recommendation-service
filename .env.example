# ─────────────────────────────────────────────────────────────────────
# Recommendation Service — environment template.
# Copy to `.env` for local runs. In Docker Compose these values are
# provided by the container environment. NEVER commit a real `.env`.
# Field names map 1:1 to settings in app/config.py (case-insensitive).
# ─────────────────────────────────────────────────────────────────────

# Runtime
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=info                   # debug | info | warning | error
HOST=0.0.0.0
PORT=8001                        # internal port; NOT published to the host

# Shared infrastructure — declared now; clients are wired in later batches.
MONGO_URI=mongodb+srv://dvbeast465:RSbQiw4qYLTaiVOH@cluster0.0m8di1d.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0              # same MongoDB cluster as the Hono backend (read-mostly)
REDIS_URL=redis://redis:6379     # same Redis instance the backend uses

# Gateway trust — enforced in a later batch via the X-Internal-Token guard.
INTERNAL_SERVICE_TOKEN=          # shared secret; the Hono gateway sends this on every call

# Model
MODEL_VERSION=heuristic-v0       # active scorer; trained XGBoost versions arrive in Phase 2

# Event ingestion (Redis Stream consumer). The consumer is a standalone worker
# (`python -m app.ingest.event_consumer`), NOT started by the API. It exits
# immediately unless EVENT_STREAM_ENABLED=true. Independent of the gateway's
# own REC_EVENT_STREAM_ENABLED publish toggle.
EVENT_STREAM_ENABLED=false
REEL_EVENTS_STREAM=reel:events
REEL_EVENTS_GROUP=rec-ingest
REEL_EVENTS_CONSUMER=rec-consumer-1

# MongoDB event persistence (consumer writes ReelEvent docs here).
# MONGO_URI is shared with the backend (see above). MONGO_DB falls back to the
# database in MONGO_URI when blank. The collection matches Mongoose's
# pluralization of the "ReelEvent" model.
MONGO_DB=
REEL_EVENTS_COLLECTION=reelevents

# Consumer tuning
CONSUMER_BLOCK_MS=5000
CONSUMER_BATCH_SIZE=50
CONSUMER_MAX_RETRIES=5
CONSUMER_CLAIM_MIN_IDLE_MS=60000

# Feature store (Redis). CODE ONLY in this batch — not activated anywhere.
FEAT_USER_PREFIX=rec:feat:user:
FEAT_REEL_PREFIX=rec:feat:reel:
FEAT_USER_TTL=3600
FEAT_REEL_TTL=600

# Source collections for feature computation (Mongoose pluralized names).
USER_INTERACTIONS_COLLECTION=userreelinteractions
REELS_COLLECTION=reels
USER_PREFERENCES_COLLECTION=userreelpreferences

# Model registry + artifacts (offline training only; not used at serving yet).
MODEL_VERSIONS_COLLECTION=rec_model_versions
MODEL_ARTIFACTS_DIR=models_artifacts

# Scheduled retraining (offline worker only; not started by the API).
RETRAIN_ENABLED=false
RETRAIN_INCREMENTAL_DAYS=1
