# Python caches
__pycache__/
*.py[cod]
*.pyo
.Python

# Virtual environments
.venv/
venv/
env/

# Local secrets — never ship into the image
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test + docs are not needed at runtime
tests/
*.md

# Model artifacts are mounted as a volume, not baked into the image
models_artifacts/

# VCS
.git/
.gitignore
